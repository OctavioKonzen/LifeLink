rules_version = '2';

// Regras do banco do LifeLink (Firestore). Cada pessoa só lê e grava os
// próprios dados: users/{uid} (nick, perfil, preferências e contador) e
// users/{uid}/decks/{id} (um documento por deck). Os amigos (quem está em
// users/{uid}/friends) também veem os decks.
//
// Amizade: quem pede grava o amigo na própria lista e um pedido na lista
// dele (users/{amigo}/requests/{eu}); quem aceita grava o outro na própria
// lista. Mesa online: tables/{código}, a partida que todos na mesa veem e mexem.
//
// Nick: cada nick é de uma pessoa só (sem diferença de maiúscula e
// minúscula) e cada pessoa escolhe o nick uma vez só. O dono de cada nick
// fica em nicks/{nick em minúsculas} = { uid, nick }, criado junto com o
// nick do perfil (na mesma transação).
//
// Para usar: Console do Firebase → Firestore Database → Regras → colar e Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Quem pede está na lista de amigos de uid (uid aceitou ou pediu).
    function isFriendOf(uid) {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid));
    }

    function nickPath(nick) {
      return /databases/$(database)/documents/nicks/$(nick.lower());
    }

    // O nick do perfil não muda depois de escolhido; ao escolher, o nick
    // precisa ficar registrado em nome desta pessoa (nicks/...).
    function nickOk(uid) {
      let before = resource == null ? null : resource.data.get('nick', null);
      let after = request.resource.data.get('nick', null);
      return before != null
        ? after == before
        : after == null || getAfter(nickPath(after)).data.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && nickOk(uid);

      match /decks/{deckId} {
        allow read: if isOwner(uid) || isFriendOf(uid);
        allow write: if isOwner(uid);
      }

      // A lista de amigos. Cada um vê a própria entrada na lista do outro
      // (para saber se o pedido já foi aceito).
      match /friends/{friendUid} {
        allow read: if isOwner(uid) || (request.auth != null && request.auth.uid == friendUid);
        allow write: if isOwner(uid);
      }

      // Pedidos de amizade: qualquer um pede em nome próprio; o dono vê e apaga.
      match /requests/{fromUid} {
        allow read, delete: if isOwner(uid);
        allow create, update: if request.auth != null && request.auth.uid == fromUid
          && request.resource.data.uid == fromUid;
      }

      // Convites para a mesa online: só quem está na lista de amigos convida.
      match /invites/{code} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isFriendOf(uid) && request.resource.data.fromUid == request.auth.uid;
      }
    }

    // Mesa online: quem tem o código (e está logado) vê e mexe na partida;
    // o dono não muda e só ele apaga a mesa.
    match /tables/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /nicks/{key} {
      // Qualquer um vê se um nick está livre (inclusive antes de criar a conta).
      allow read: if true;
      // Só quem ainda não tem nick registra um, e junto com o próprio perfil.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && key == request.resource.data.nick.lower()
        && (!exists(userPath(request.auth.uid)) || get(userPath(request.auth.uid)).data.get('nick', null) == null)
        && getAfter(userPath(request.auth.uid)).data.get('nick', null) == request.resource.data.nick;
      // Ao excluir a conta, o nick fica livre de novo.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
